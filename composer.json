{
    "name": "priyankrajput/laravel-upgrader",
    "description": "A Laravel package to manage package upgrades with a nice UI",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "priyankrajput",
            "email": "er.priyankrajput@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "priyank\\LaravelUpgrader\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "priyank\\LaravelUpgrader\\Providers\\UpgraderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
